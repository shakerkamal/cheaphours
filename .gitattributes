* text=auto

# The committed OpenAPI contract must compare byte-for-byte on Windows and Linux.
docs/api/*.json text eol=lf

*.sh text eol=lf

# Third-party OCPP schemas are kept byte-for-byte as published (hash-checked by tests).
src/CheapHours.Providers.Ocpp/Schemas/v16/*.json text eol=lf

# Recorded Energy-Charts price responses are kept byte-for-byte as the source returned them.
tests/CheapHours.UnitTests/Prices/Fixtures/*.json text eol=lf
