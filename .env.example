# Copy to .env (git-ignored) and fill in. See README "Run locally".
#
# Generate a charger password (20 random bytes as 40 hex characters) and its SHA-256:
#   PowerShell: $p = [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(20)).ToLowerInvariant(); $p
#               [Convert]::ToHexString([Security.Cryptography.SHA256]::HashData([Text.Encoding]::UTF8.GetBytes($p))).ToLowerInvariant()
#   bash:       p=$(openssl rand -hex 20); echo "$p"; printf %s "$p" | sha256sum | cut -d' ' -f1
# Put the password here and the hash into the gateway's user secrets:
#   dotnet user-secrets --project src/CheapHours.Host set "Providers:Ocpp:ChargePoints:0:PasswordHash" <hash>

# The simulator's charge point id; must match Providers:Ocpp:ChargePoints:0:Id (CP001 in Development).
CP_ID=CP001
# The simulator's basic-auth password (40 hex characters).
CP_PASSWORD=
# The port the gateway listens on (dotnet run ... --role gateway --urls http://localhost:5081).
GATEWAY_PORT=5081

# RabbitMQ's account. Generate a password the same way as above (any long random string works), put it
# here, and give the gateway and worker the matching connection string through user secrets:
#   dotnet user-secrets --project src/CheapHours.Host set "ConnectionStrings:RabbitMq" "amqp://cheaphours:<password>@localhost:5672/"
RABBITMQ_USER=cheaphours
RABBITMQ_PASSWORD=

# The car-cloud simulator's client secret and the seed refresh token of its demo account (acct_demo).
# Generate each the same way as above (any long random string works), put them here, and give the worker
# the same values through user secrets:
#   dotnet user-secrets --project src/CheapHours.Host set "Providers:CarCloud:ClientSecret" <client secret>
#   dotnet user-secrets --project src/CheapHours.Host set "Providers:CarCloud:Accounts:0:RefreshToken" <seed refresh token>
# The seed works once: the simulator rotates it and the worker stores the new token. After restarting the
# simulator (which forgets rotated tokens), see README "Re-link the car-cloud account".
CARCLOUD_CLIENT_SECRET=
CARCLOUD_SEED_REFRESH_TOKEN=

# The heat-pump-cloud simulator's webhook signing secret: at least 32 characters, for example 32 random
# bytes as 64 hex characters (openssl rand -hex 32, or the PowerShell line above with 32 instead of 20).
# Put it here and give the gateway the same value through user secrets:
#   dotnet user-secrets --project src/CheapHours.Host set "Providers:HeatPumpCloud:SigningSecret" <secret>
HEATPUMP_SIGNING_SECRET=
