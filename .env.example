# Copy to .env (git-ignored) and fill in. See README "Run locally".
#
# Generate a charger password (20 random bytes as 40 hex characters) and its SHA-256:
#   PowerShell: $p = [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(20)).ToLowerInvariant(); $p
#               [Convert]::ToHexString([Security.Cryptography.SHA256]::HashData([Text.Encoding]::UTF8.GetBytes($p))).ToLowerInvariant()
#   bash:       p=$(openssl rand -hex 20); echo "$p"; printf %s "$p" | sha256sum | cut -d' ' -f1
# Put the password here and the hash into the gateway's user secrets:
#   dotnet user-secrets --project src/CheapHours.Host set "Providers:Ocpp:ChargePoints:0:PasswordHash" <hash>

# The simulator's charge point id; must match Providers:Ocpp:ChargePoints:0:Id (CP001 in Development).
CP_ID=CP001
# The simulator's basic-auth password (40 hex characters).
CP_PASSWORD=
# The port the gateway listens on (dotnet run ... --role gateway --urls http://localhost:5081).
GATEWAY_PORT=5081
